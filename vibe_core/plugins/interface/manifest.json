{
    "type": "plugin",
    "id": "interface",
    "name": "Unified Interface Plugin",
    "version": "1.1.0",
    "description": "Orchestrates all UI rendering (Markdown Views) for the system.",
    "entry_point": "plugin_main.py",
    "entry_class": "InterfacePlugin",
    "priority": 100,
    "enabled": true,
    "hooks": [
        "on_boot",
        "on_pulse"
    ],
    "dependencies": [],
    "defaults": {
        "render_interval_seconds": 1,
        "enabled_views": [
            "envoy",
            "settings",
            "dashboard",
            "agents",
            "citymap",
            "ephemeral",
            "opus"
        ]
    },
    "generated_outputs": {
        "_comment": "OPUS-081: Files generated by this plugin (RUNTIME STATE, not source code)",
        "dashboard_files": [
            "OPUS.md",
            "ENVOY.md",
            "AGENTS.md",
            "ARCHITECTURE.md",
            "CITYMAP.md",
            "COGNITION.md",
            "EPHEMERAL.md",
            "GIT.md",
            "HELP.md",
            "INDEX.md",
            "MATRIX.md",
            "OPERATIONS.md",
            "README.md",
            "SETTINGS.md",
            "TASKS.md"
        ]
    },
    "author": "STEWARD Protocol",
    "tags": [
        "ui",
        "interface",
        "core"
    ]
}
