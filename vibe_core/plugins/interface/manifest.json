{
    "type": "plugin",
    "id": "interface",
    "name": "Unified Interface Plugin",
    "version": "1.0.0",
    "description": "Orchestrates all UI rendering (Markdown Views) for the system.",
    "entry_point": "plugin_main.py",
    "entry_class": "InterfacePlugin",
    "priority": 100,
    "enabled": true,
    "hooks": [
        "on_boot",
        "on_tick_post",
        "on_shutdown"
    ],
    "dependencies": [],
    "defaults": {
        "render_interval_seconds": 1,
        "enabled_views": [
            "envoy",
            "settings",
            "dashboard",
            "agents",
            "citymap",
            "ephemeral"
        ]
    },
    "author": "STEWARD Protocol",
    "tags": [
        "ui",
        "interface",
        "core"
    ]
}