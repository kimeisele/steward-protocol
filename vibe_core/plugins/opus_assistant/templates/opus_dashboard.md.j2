{#
  OPUS Dashboard Template - The Living UI

  This template is READ by opus_assistant to render OPUS.md.
  It is also READABLE by OPUS itself for self-modification.

  Data Context (passed from OpusDashboardRenderer):
    - timestamp: Current UTC timestamp
    - trust_score: 0-100 verification trust score
    - health_status: HEALTHY|DEGRADED|WARNING|CRITICAL
    - kernel: { status, agent_count }
    - git: { branch, sha, dirty, uncommitted_files }
    - session: { id, boot_mode, view_preferences } or null
    - karma: { current_score, boot_mode, history, trend }
    - treasury: { date, tokens_input, estimated_cost, ... } or null
    - syscalls: { history, stats } or null (Layer 2: Experience Replay)
    - pending_intent: { intent, syscall_type, params, approved, ... } or null (Layer 1.5)
    - layers: { sthula, prana, purusha }
    - focus_areas: list of strings
    - journal: list of { timestamp, severity, source, message }
    - circuits: list of { id, triggers, states, description }
    - verification: { total_score, docs }
    - architecture_plans: list of { name, path }
    - code_health: { todos, hacks, fixmes }
    - test_health: { active, archived, organized }
    - sutra: { total_docs, docs_with_harness, gaps_count, health_pct, top_gaps } or null (OPUS-054)
    - preserved: { current_work, blockers, notes }
#}

{# ============================================================================
   MACROS - Reusable Components
   ============================================================================ #}

{% macro status_badge(health, trust) %}
{%- if trust >= 80 -%}
**🟢 HEALTHY**
{%- elif trust >= 60 -%}
**🟡 DEGRADED**
{%- elif trust >= 40 -%}
**🟠 WARNING**
{%- else -%}
**🔴 CRITICAL**
{%- endif -%}
{% endmacro %}

{% macro severity_icon(severity) %}
{%- if severity == 'INFO' -%}ℹ️{%- endif -%}
{%- if severity == 'WARN' -%}⚠️{%- endif -%}
{%- if severity == 'ALERT' -%}🚨{%- endif -%}
{%- if severity == 'INSIGHT' -%}💡{%- endif -%}
{% endmacro %}

{% macro circuit_action_link(circuit_id) %}
[⚡ Run](command:steward.circuit.run?id={{ circuit_id }})
{% endmacro %}

