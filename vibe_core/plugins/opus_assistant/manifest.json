{
  "type": "plugin",
  "id": "opus_assistant",
  "name": "OPUS Assistant",
  "version": "1.6.0",
  "description": "Self-maintaining OPUS.md with verification, drift detection, and auto-refresh circuits",

  "entry_point": "plugin_main.py",
  "entry_class": "OpusAssistantPlugin",

  "priority": 50,
  "enabled": true,

  "hooks": [
    "on_boot",
    "on_shutdown"
  ],

  "dependencies": [],

  "capabilities": [
    "opus.verify",
    "opus.drift_detect",
    "opus.context",
    "opus.journal",
    "opus.cli",
    "opus.circuits",
    "opus.state",
    "opus.bhakti"
  ],

  "state": {
    "dir": ".opus_state",
    "files": {
      "observations": "observations.jsonl",
      "karma_history": "karma_history.jsonl",
      "session": "session.json"
    },
    "git_tracked": true,
    "max_observations": 1000,
    "max_karma_entries": 100
  },

  "generated_outputs": {
    "_comment": "OPUS-081: Files generated by this plugin (RUNTIME STATE)",
    "state_files": [
      ".opus_state/observations.jsonl",
      ".opus_state/karma_history.jsonl",
      ".opus_state/session.json"
    ]
  },

  "circuits": [
    "circuits/auto_verify.yaml",
    "circuits/auto_heal.yaml",
    "circuits/auto_refresh.yaml",
    "circuits/karma_consequence.yaml",
    "circuits/genesis_check.yaml",
    "circuits/bhakti_practice.yaml"
  ],

  "cli": {
    "namespace": "opus",
    "commands": [
      {
        "name": "status",
        "handler": "cmd_opus_status",
        "execution_mode": "hybrid",
        "help": "Show current system 'State of Mind' (live context)",
        "args": [
          {
            "name": "json",
            "type": "bool",
            "help": "Output as JSON for pipelines",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "name": "log",
        "handler": "cmd_opus_log",
        "execution_mode": "offline",
        "help": "Show journal entries from OPUS.md",
        "args": [
          {
            "name": "limit",
            "type": "int",
            "help": "Max entries to show",
            "required": false,
            "default": 20
          },
          {
            "name": "json",
            "type": "bool",
            "help": "Output as JSON for pipelines",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "name": "verify",
        "handler": "cmd_opus_verify",
        "execution_mode": "hybrid",
        "help": "Run manual verification (check @HARNESS rules)",
        "args": [
          {
            "name": "quick",
            "type": "bool",
            "help": "Skip semantic checks (faster)",
            "required": false,
            "default": false
          },
          {
            "name": "json",
            "type": "bool",
            "help": "Output as JSON for pipelines",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "name": "refresh",
        "handler": "cmd_opus_refresh",
        "execution_mode": "offline",
        "help": "Regenerate OPUS.md (manual trigger)",
        "args": [
          {
            "name": "quick",
            "type": "bool",
            "help": "Skip semantic checks (faster)",
            "required": false,
            "default": true
          },
          {
            "name": "json",
            "type": "bool",
            "help": "Output as JSON for pipelines",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "name": "explore",
        "handler": "cmd_opus_explore",
        "execution_mode": "offline",
        "help": "Token-efficient codebase exploration (better than RAG)",
        "args": [
          {
            "name": "query",
            "type": "str",
            "help": "What to explore (e.g., 'authentication', 'kernel', 'plugins')",
            "required": true
          },
          {
            "name": "limit",
            "type": "int",
            "help": "Max files to return",
            "required": false,
            "default": 10
          },
          {
            "name": "deep",
            "type": "bool",
            "help": "Deep mode: read files, analyze imports, prepare LLM synthesis task",
            "required": false,
            "default": false
          },
          {
            "name": "json",
            "type": "bool",
            "help": "Output as JSON for pipelines",
            "required": false,
            "default": false
          }
        ]
      }
    ]
  },

  "defaults": {
    "auto_verify_on_boot": false,
    "drift_detection_enabled": true
  },

  "author": "STEWARD Protocol",
  "tags": ["opus", "verification", "assistant", "governance", "cli"]
}
